# --- product icons: extracted from the commercial game's own asset files. ---
# Not committed pending a fair-use/attribution determination (see ATTRIBUTION.md).
# The folder itself is tracked (via .gitkeep) so the site's relative image
# paths resolve locally once icons are populated from your own legitimately
# owned copy of the game.
#
# Ignores every file in the folder, not just *.png: icons extracted as .webp,
# .gif or .bmp are the same unresolved question as the PNGs, and an ignore rule
# that names one format silently permits the others. Note that this rule is the
# ONLY thing keeping the icons out of git -- it does not protect a non-git
# deploy path (rsync/drag-and-drop of a populated local site/ directory).
/site/images/*
!/site/images/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors / tooling
.idea/
.vscode/

# Agent scratch space (Conductor workspaces). Ignored here rather than only in
# .git/info/exclude, which is per-clone and does not travel with the repo --
# without this line a fresh clone treats .context/ as untracked and one
# `git add -A` publishes it.
.context/

# macOS cruft
.DS_Store

# --- Development-only accessibility harness (see package.json) ---
# None of this ships. site/index.html vendors nothing and has no runtime
# dependency; the pages workflow fails closed on any file appearing under site/.
/node_modules/
/playwright-report/
/test-results/
/blob-report/

# Spliced harness written by tests/run_site_tests.py next to itself, inside the
# repo. Removed in a finally block, so it exists only after an interrupted run --
# but one `git add -A` at the wrong moment would commit a generated file.
/tests/_site_behaviour.generated.js
