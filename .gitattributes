# Normalize line endings on the way into the repo. tools/build_site.py writes
# site/index.html as raw bytes with LF specifically so a Windows build does not
# produce a whole-file diff; this keeps the hand-authored sources consistent
# with that.
* text=auto eol=lf

# site/index.html is generated by tools/build_site.py (template + product JSON)
# and is committed only so the site can be used by cloning and opening it. Its
# entire product payload is a single ~178 KB line, so a one-character data
# change otherwise yields ~350 KB of unreadable diff that no reviewer can read
# -- exactly the condition under which a corrupted or injected build slips
# through unnoticed. Suppress the diff and mark it generated; verify it instead
# with `python3 tools/build_site.py --check`.
site/index.html -diff linguist-generated=true

# Vendored third-party bundle: not our code, excluded from language stats and
# from diffs for the same reason.
site/d3.min.js -diff linguist-vendored=true
